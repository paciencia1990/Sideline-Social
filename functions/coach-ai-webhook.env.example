# Public deployment values only. Do not edit the live environment from this file.
# Owner-generated bearer token and RevenueCat HMAC key belong in Secret Manager.
# First, deploy the dedicated setup receiver; it cannot read/write billing data.
COACH_AI_WEBHOOK_MODE=bootstrap
COACH_AI_PAID_ENABLED=false
