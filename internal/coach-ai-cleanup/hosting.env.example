# Reference only. These settings are not applied by any script in this change.
# Run exactly one service role with Node 22:
# node internal/coach-ai-cleanup/host/bootstrap.cjs console
# node internal/coach-ai-cleanup/host/bootstrap.cjs observer
PORT=8080
CLEANUP_PROJECT_ID=sideline-social-staging-2026
CLEANUP_READS_ENABLED=false
CLEANUP_MUTATIONS_ENABLED=false
CLEANUP_LOGIN_ENABLED=false
CLEANUP_OBSERVER_ENABLED=false
# Console: set the exact reviewed HTTPS origin, without trailing slash.
CLEANUP_ORIGIN=
# Before console reads/login: privately resolve the existing public Auth web key,
# distinct current operator UID pins, and secret-injected verification key v1.
CLEANUP_FIREBASE_WEB_API_KEY=
CLEANUP_PRIMARY_UID=
CLEANUP_BACKUP_UID=
# REVENUECAT_VERIFICATION_KEY is injected by the future runtime, never committed.
# Observer only: actual Cloud Run service origin and scheduler account numeric ID.
CLEANUP_OBSERVER_AUDIENCE=
CLEANUP_SCHEDULER_SUBJECT_ID=
