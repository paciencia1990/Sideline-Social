rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------
    function authenticated() {
      return request.auth != null;
    }

    function anonymousAuth() {
      return authenticated() &&
        request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function permanentSignedIn() {
      return authenticated() && !anonymousAuth();
    }

    function accountStandingPath(userId) {
      return /databases/$(database)/documents/accountStanding/$(userId);
    }

    function hasCurrentStandingRecord(userId) {
      return exists(accountStandingPath(userId)) &&
        (
          !("expiresAt" in get(accountStandingPath(userId)).data) ||
          !(get(accountStandingPath(userId)).data.expiresAt is timestamp) ||
          get(accountStandingPath(userId)).data.expiresAt > request.time
        );
    }

    // Missing and expired standing records are active. Suspensions and bans
    // fail closed for every ordinary social read/write.
    function signedIn() {
      return permanentSignedIn() &&
        (
          !hasCurrentStandingRecord(request.auth.uid) ||
          get(accountStandingPath(request.auth.uid)).data.status == "active"
        );
    }

    function canCommunicate() {
      return signedIn() &&
        (
          !hasCurrentStandingRecord(request.auth.uid) ||
          !("messagingRestricted" in get(accountStandingPath(request.auth.uid)).data) ||
          get(accountStandingPath(request.auth.uid)).data.messagingRestricted != true
        );
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function squadPath(squadId) {
      return /databases/$(database)/documents/squads/$(squadId);
    }

    function squadMembershipPath(squadId, userId) {
      return /databases/$(database)/documents/squadMemberships/$(squadId + "__" + userId);
    }

    function isExplicitActiveSquadAdmin(squadId) {
      return signedIn() &&
        exists(squadMembershipPath(squadId, request.auth.uid)) &&
        get(squadMembershipPath(squadId, request.auth.uid)).data.membershipStatus == "active" &&
        get(squadMembershipPath(squadId, request.auth.uid)).data.squadRole == "admin";
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function teamMemberPath(teamId, userId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(userId);
    }

    function friendConversationMemberPath(conversationId, userId) {
      return /databases/$(database)/documents/friendConversations/$(conversationId)/members/$(userId);
    }

    function isActiveFriendConversationMember(conversationId) {
      return signedIn() &&
        exists(friendConversationMemberPath(conversationId, request.auth.uid)) &&
        get(friendConversationMemberPath(conversationId, request.auth.uid)).data.status == "active";
    }

    function isInvitedFriendConversationMember(conversationId) {
      return signedIn() &&
        exists(friendConversationMemberPath(conversationId, request.auth.uid)) &&
        get(friendConversationMemberPath(conversationId, request.auth.uid)).data.status == "invited";
    }
    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function sessionExists(sessionId) {
      return exists(sessionPath(sessionId));
    }

    function sessionData(sessionId) {
      return get(sessionPath(sessionId)).data;
    }

    function isSessionHost(sessionId) {
      return canCommunicate() &&
        sessionExists(sessionId) &&
        sessionData(sessionId).expiresAt is timestamp &&
        sessionData(sessionId).expiresAt > request.time &&
        sessionLifecycleReadable(sessionId) &&
        sessionData(sessionId).hostPlayerId == request.auth.uid;
    }

    function sessionLifecycleReadable(sessionId) {
      return sessionData(sessionId).status in ["lobby", "playing"] ||
        (
          sessionData(sessionId).status == "results" &&
          sessionData(sessionId).completedAt is timestamp &&
          sessionData(sessionId).completedAt + duration.value(5, "m") > request.time
        );
    }

    function isSessionPlayer(sessionId) {
      return canCommunicate() &&
        sessionExists(sessionId) &&
        sessionData(sessionId).expiresAt is timestamp &&
        sessionData(sessionId).expiresAt > request.time &&
        sessionLifecycleReadable(sessionId) &&
        (
          sessionData(sessionId).hostPlayerId == request.auth.uid ||
          request.auth.uid in sessionData(sessionId).playerIds
        );
    }

    function announcementPath(teamId, announcementId) {
      return /databases/$(database)/documents/teams/$(teamId)/announcements/$(announcementId);
    }

    function privateTeamConversationPath(conversationId) {
      return /databases/$(database)/documents/teamPrivateConversations/$(conversationId);
    }

    function isPrivateTeamConversationParticipant(conversationId) {
      return signedIn() &&
        exists(privateTeamConversationPath(conversationId)) &&
        get(privateTeamConversationPath(conversationId)).data.participantUserIds is list &&
        get(privateTeamConversationPath(conversationId)).data.participantUserIds.size() == 2 &&
        request.auth.uid in get(privateTeamConversationPath(conversationId)).data.participantUserIds;
    }

    function isSquadMember(squadId) {
      return signedIn() &&
        exists(squadPath(squadId)) &&
        (
          (
            exists(squadMembershipPath(squadId, request.auth.uid)) &&
            get(squadMembershipPath(squadId, request.auth.uid)).data.userId == request.auth.uid &&
            get(squadMembershipPath(squadId, request.auth.uid)).data.squadId == squadId &&
            get(squadMembershipPath(squadId, request.auth.uid)).data.membershipStatus == "active"
          ) ||
          (
            !exists(squadMembershipPath(squadId, request.auth.uid)) &&
            get(squadPath(squadId)).data.memberIds is list &&
            request.auth.uid in get(squadPath(squadId)).data.memberIds
          )
        );
    }

    function isTeamMember(teamId) {
      return signedIn() &&
        exists(teamMemberPath(teamId, request.auth.uid)) &&
        get(teamMemberPath(teamId, request.auth.uid)).data.status == "active";
    }

    function isTeamActive(teamId) {
      return exists(teamPath(teamId)) &&
        (!("status" in get(teamPath(teamId)).data) || get(teamPath(teamId)).data.status == "active");
    }

    function hasParentRoleData(data) {
      return (data.roles is map && data.roles.parent == true) || data.role == "parent";
    }

    function hasCoachRoleData(data) {
      return (data.roles is map && data.roles.coach == true) || data.role == "coach";
    }

    function hasStaffRoleData(data) {
      return (data.roles is map && data.roles.staff == true) ||
        data.role in ["assistantCoach", "teamParent"];
    }

    function hasCoachAccessData(data) {
      return hasCoachRoleData(data) || hasStaffRoleData(data);
    }

    function isCoachStaff(teamId) {
      return isTeamMember(teamId) &&
        hasCoachAccessData(get(teamMemberPath(teamId, request.auth.uid)).data);
    }

    function isTeamCoach(teamId) {
      return isTeamActive(teamId) &&
        isTeamMember(teamId) &&
        (
          hasCoachRoleData(get(teamMemberPath(teamId, request.auth.uid)).data) ||
          get(teamPath(teamId)).data.createdBy == request.auth.uid
        );
    }

    function isParentTeamMember(teamId) {
      return isTeamMember(teamId) &&
        hasParentRoleData(get(teamMemberPath(teamId, request.auth.uid)).data);
    }

    function canReadTeamAnnouncement(teamId) {
      return isTeamActive(teamId) &&
        isTeamMember(teamId) &&
        (
          isCoachStaff(teamId) ||
          (isParentTeamMember(teamId) && resource.data.audience in ["parents", "all", "everyone"])
        );
    }

    function canReadAnnouncementPath(teamId, announcementId) {
      return isTeamActive(teamId) &&
        isTeamMember(teamId) &&
        exists(announcementPath(teamId, announcementId)) &&
        (
          isCoachStaff(teamId) ||
          (
            isParentTeamMember(teamId) &&
            get(announcementPath(teamId, announcementId)).data.audience in ["parents", "all", "everyone"]
          )
        );
    }
    function canReadTeamReply(teamId, announcementId) {
      return canReadAnnouncementPath(teamId, announcementId) &&
        (
          isCoachStaff(teamId) ||
          resource.data.replyType == "team"
        );
    }

    function isValidOwnAnnouncementRead(teamId, announcementId, userId) {
      return isSelf(userId) &&
        canReadAnnouncementPath(teamId, announcementId) &&
        request.resource.data.keys().hasOnly(["userId", "readAt"]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.readAt is timestamp;
    }
    function isTeamCreator(teamId) {
      return signedIn() &&
        existsAfter(teamPath(teamId)) &&
        getAfter(teamPath(teamId)).data.createdBy == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // users collection
    // Private account documents may contain email and authentication metadata.
    // Cross-user social names are returned only by field-limited callables.
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSelf(userId);
      allow list: if false;
      allow create: if isSelf(userId) &&
        canCommunicate() &&
        (!("sidelineStars" in request.resource.data) || request.resource.data.sidelineStars == 0) &&
        (!("squadIds" in request.resource.data) || (
          request.resource.data.squadIds is list && request.resource.data.squadIds.size() == 0
        )) &&
        (!("selectedSquadId" in request.resource.data) || request.resource.data.selectedSquadId == null);
      allow update: if isSelf(userId) &&
        canCommunicate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "accountStanding", "squadIds", "selectedSquadId", "sidelineStars"
        ]);
      allow delete: if false;

      match /children/{childId} {
        allow get, list: if isSelf(userId);
        allow create: if isSelf(userId) &&
          canCommunicate() &&
          request.resource.data.keys().hasOnly(["displayName", "createdAt", "updatedAt"]) &&
          request.resource.data.keys().hasAll(["displayName", "createdAt", "updatedAt"]) &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 80 &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
        allow update: if isSelf(userId) &&
          canCommunicate() &&
          request.resource.data.keys().hasOnly(["displayName", "createdAt", "updatedAt"]) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 80 &&
          request.resource.data.updatedAt is timestamp;
        // Deletion is owner-initiated through a callable that checks team links.
        allow delete: if false;
      }

      match /teamChildLinks/{teamId} {
        allow get, list: if isSelf(userId);
        // Relationship writes require callable ownership and membership checks.
        allow create, update, delete: if false;
      }

      match /weeklyChallenges/{weekKey} {
        allow read: if isSelf(userId);
        // Assignments and completion rewards are written only by trusted
        // callable functions using the Admin SDK.
        allow create, update, delete: if false;
      }

      match /rewardTransactions/{transactionId} {
        allow read: if isSelf(userId);
        allow create, update, delete: if false;
      }
    }

    // Minimal authenticated identity projection. Documents contain only the
    // canonical public name/photo and normalized name-search fields produced
    // by trusted server code.
    match /publicUserProfiles/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Server-only counters bound authenticated directory search volume.
    match /publicUserSearchRateLimits/{userId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // notificationTokens collection
    // Device tokens contain private delivery credentials and are managed only
    // by authenticated callable functions using the Admin SDK.
    // -----------------------------------------------------------------------
    match /notificationTokens/{tokenId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Private personal notification inbox
    // Trusted Cloud Functions create notifications and own all read/dismiss
    // mutations. Recipients can read only their own inbox.
    // -----------------------------------------------------------------------
    match /userNotifications/{userId} {
      allow read, write: if false;

      match /notifications/{notificationId} {
        allow get, list: if isSelf(userId);
        allow create, update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Private friend Chat
    // Conversation, membership, message, moderation, and read-state writes
    // are callable-only. List queries must constrain the authenticated UID in
    // the relevant active/invited participant projection.
    // -----------------------------------------------------------------------
    match /friendConversations/{conversationId} {
      allow get, list: if signedIn() && (
        request.auth.uid in resource.data.activeParticipantIds ||
        request.auth.uid in resource.data.invitedParticipantIds
      );
      allow create, update, delete: if false;

      match /members/{userId} {
        allow get: if signedIn() && userId == request.auth.uid;
        allow list: if false;
        allow create, update, delete: if false;
      }

      match /memberProfiles/{userId} {
        allow get, list: if signedIn() && (
          (isActiveFriendConversationMember(conversationId) && resource.data.status == "active") ||
          userId == request.auth.uid ||
          (isInvitedFriendConversationMember(conversationId) && resource.data.status == "active")
        );
        allow create, update, delete: if false;
      }

      match /messages/{messageId} {
        allow get, list: if isActiveFriendConversationMember(conversationId) &&
          request.auth.uid in resource.data.visibleToUserIds;
        allow create, update, delete: if false;

        match /reactions/{userId} {
          allow get, list: if isActiveFriendConversationMember(conversationId) &&
            exists(/databases/$(database)/documents/friendConversations/$(conversationId)/messages/$(messageId)) &&
            get(/databases/$(database)/documents/friendConversations/$(conversationId)/messages/$(messageId)).data.status == "active" &&
            (
              !("moderationState" in get(/databases/$(database)/documents/friendConversations/$(conversationId)/messages/$(messageId)).data) ||
              !(get(/databases/$(database)/documents/friendConversations/$(conversationId)/messages/$(messageId)).data.moderationState in ["hidden", "removed"])
            ) &&
            (
              !("messageType" in get(/databases/$(database)/documents/friendConversations/$(conversationId)/messages/$(messageId)).data) ||
              get(/databases/$(database)/documents/friendConversations/$(conversationId)/messages/$(messageId)).data.messageType != "system"
            ) &&
            request.auth.uid in get(/databases/$(database)/documents/friendConversations/$(conversationId)/messages/$(messageId)).data.visibleToUserIds;
          allow create, update, delete: if false;
        }
      }

      match /userMessageStates/{userId}/messages/{messageId} {
        allow get, list: if signedIn() &&
          request.auth.uid == userId &&
          isActiveFriendConversationMember(conversationId);
        allow create, update, delete: if false;
      }
    }

    match /friendChatUploadReservations/{reservationId} {
      allow read, write: if false;
    }

    match /friendChatForwardRateLimits/{userHash} {
      allow read, write: if false;
    }

    match /friendChatMediaPlaybackGrants/{grantId} {
      allow read, write: if false;
    }

    match /userBlocks/{blockerUserId} {
      allow read, write: if false;
      match /blockedUsers/{blockedUserId} {
        allow read, write: if false;
      }
    }

    match /chatModerationReports/{reportId} {
      allow read, write: if false;
    }

    match /contentModerationReports/{reportId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Friend requests
    // Participants may read request state. All identity, duplicate, response,
    // and friendship mutations are enforced by authenticated callables.
    // -----------------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow get, list: if signedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // squads collection
    // Squads stay separate from Teams. Coach staff rules do not grant Squad
    // write privileges.
    // -----------------------------------------------------------------------
    match /squads/{squadId} {
      allow get: if isSquadMember(squadId);
      allow list: if false;
      // Canonical identity, membership projections, and counts are managed by
      // trusted callable functions so concurrent clients cannot create a
      // duplicate venue-and-sport Squad or modify another membership.
      allow create, update, delete: if false;

      match /seasons/{seasonId} {
        // The field-limited season and leaderboard callables are the only
        // client read path, so internal creator/closure audit UIDs stay private.
        allow read, create, update, delete: if false;

        match /memberTotals/{userId} {
          // Seasonal leaderboard rows are privacy-filtered by the callable.
          allow read, create, update, delete: if false;

          match /contributions/{rewardId} {
            allow read, create, update, delete: if false;
          }
        }
      }
    }

    // -----------------------------------------------------------------------
    // squadMemberships collection
    // Users can read only their own memberships. Cloud Functions use the
    // Admin SDK and bypass these rules for every mutation.
    // -----------------------------------------------------------------------
    match /squadMemberships/{membershipId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // Durable membership and expiring presence are both server-managed.
      allow create, update, delete: if false;
    }

    // Squad administrator authority and invitation state are server-managed.
    // Recipients may read their own invitation; explicit active admins may read
    // the invitation roster for management. Legacy creator fallback is healed
    // by trusted server operations and is intentionally not reproduced here.
    match /squadAdminInvitations/{invitationId} {
      allow get, list: if signedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        isExplicitActiveSquadAdmin(resource.data.squadId)
      );
      allow create, update, delete: if false;
    }

    match /squadAdminAccessRequests/{requestId} {
      allow get, list: if signedIn() && resource.data.requesterUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Minimal canonical terminal records for locally played rewarded games.
    // Clients cannot read participant IDs/results or forge completion. The
    // authenticated reward callables use the Admin SDK for all access.
    match /gameRewardSessions/{sessionId} {
      allow read, create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // teams collection
    // Teams are private official coach/team spaces, separate from Squads.
    // -----------------------------------------------------------------------
    match /teams/{teamId} {
      allow get: if isTeamMember(teamId);
      allow list: if false;

      allow create: if canCommunicate() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == "active" &&
        request.resource.data.coachIds is list &&
        request.resource.data.coachIds.hasOnly([request.auth.uid]) &&
        request.resource.data.coachIds.hasAll([request.auth.uid]) &&
        request.resource.data.parentIds is list &&
        request.resource.data.parentIds.size() == 0;

      allow update: if canCommunicate() &&
        isTeamCoach(teamId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "sport", "ageRange", "division", "season", "leagueId", "squadId", "updatedAt"
        ]);
      allow delete: if false;

      match /members/{userId} {
        allow get: if isSelf(userId) || isCoachStaff(teamId);
        allow list: if isCoachStaff(teamId);

        allow create: if canCommunicate() &&
          request.resource.data.userId == userId &&
          request.resource.data.teamId == teamId &&
          request.resource.data.status == "active" &&
          (
            (
              isSelf(userId) &&
              hasCoachRoleData(request.resource.data) &&
              isTeamCreator(teamId)
            )
          );

        // Membership mutations, including team-scoped staff access and private
        // child relationships, are validated by authenticated callable functions.
        allow update: if false;
        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow get, list: if canReadTeamAnnouncement(teamId);

        // Text and voice announcements are created by authenticated callables
        // so identity, rate limiting, and content safety checks cannot be bypassed.
        allow create, update: if false;

        // Announcement deletion recursively removes protected descendants and
        // notification inbox entries through deleteTeamAnnouncement only.
        allow delete: if false;

        match /replies/{replyId} {
          allow get, list: if canReadTeamReply(teamId, announcementId);

          // Reply identity, membership, ownership, moderation, and timestamps
          // are enforced by authenticated callable functions using the Admin SDK.
          allow create, update, delete: if false;
        }

        match /reads/{userId} {
          allow get: if isSelf(userId) && canReadAnnouncementPath(teamId, announcementId);
          allow list: if false;
          allow create, update: if isValidOwnAnnouncementRead(teamId, announcementId, userId);
          allow delete: if false;
        }
      }

      match /events/{eventId} {
        // Active memberships retain read-only access when a Team is archived.
        // Schedule mutations are callable-only so role, lifecycle, timestamps,
        // recurrence limits, imports, and notifications remain server-authoritative.
        allow get, list: if isTeamMember(teamId);
        allow create, update, delete: if false;
      }
    }

    match /teamPrivateConversations/{conversationId} {
      allow get, list: if resource.data.participantUserIds is list &&
        resource.data.participantUserIds.size() == 2 &&
        signedIn() &&
        request.auth.uid in resource.data.participantUserIds;
      allow create, update, delete: if false;

      match /members/{userId} {
        allow get: if isSelf(userId) && isPrivateTeamConversationParticipant(conversationId);
        allow list, create, update, delete: if false;

        match /hiddenMessages/{messageId} {
          // Visibility records are written only by the trusted hide-message
          // callable. A participant may subscribe only to their own records so
          // hidden messages never flash while a private thread is loading.
          allow get, list: if isSelf(userId) && isPrivateTeamConversationParticipant(conversationId);
          allow create, update, delete: if false;
        }
      }

      match /messages/{messageId} {
        allow get, list: if isPrivateTeamConversationParticipant(conversationId);
        allow create, update, delete: if false;
      }
    }

    match /teamVoiceUploadReservations/{reservationId} {
      allow read, write: if false;
    }

    match /teamMessageRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Short game codes are routing credentials. All lookup, reservation,
    // joining, lifecycle, and throttling operations run through callables.
    match /gameJoinCodes/{code} {
      allow read, write: if false;
    }

    match /gameJoinSessionLinks/{linkId} {
      allow read, write: if false;
    }

    match /gameJoinRequests/{requestId} {
      allow read, write: if false;
    }

    match /gameJoinRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Multiplayer lobby discovery, active membership, idempotency, and
    // creation throttling are projected only through authenticated callables.
    match /gameLobbyDirectories/{directoryId} {
      allow read, write: if false;
    }

    match /gameLobbyCreateRequests/{requestId} {
      allow read, write: if false;
    }

    match /activeGameLobbyMemberships/{userId} {
      allow read, write: if false;
    }

    match /gameLobbyCreationRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Start timing is server-authored. Frozen participants can read only the
    // public phase/timeline record; acknowledgements and snapshots stay behind
    // authenticated callable functions.
    match /gameStartStates/{stateId} {
      allow get: if signedIn() &&
        (
          !exists(/databases/$(database)/documents/gameStartStates/$(stateId)) ||
          (
            resource.data.participantUserIds is list &&
            request.auth.uid in resource.data.participantUserIds
          )
        );
      allow list, create, update, delete: if false;

      match /participants/{userId} {
        allow read, write: if false;
      }
    }

    match /triviaGameSecrets/{sessionId} {
      allow read, write: if false;
    }

    match /triviaGameSubmissions/{submissionId} {
      allow read, write: if false;
    }

    match /triviaGameRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Trivia Blitz game sessions
    // Cloud Functions are the only writers. Participants receive only the
    // server-projected current question; answer keys stay in a server-only
    // collection that has no client rule.
    // -----------------------------------------------------------------------
    match /sessions/{sessionId} {
      allow get: if isSessionPlayer(sessionId);
      allow list: if false;
      allow write: if false;

      match /games/{gameId} {
        allow get: if gameId == "triviaBlitz" && isSessionPlayer(sessionId);
        allow list: if false;
        allow write: if false;

        match /players/{playerId} {
          allow get, list: if gameId == "triviaBlitz" && isSessionPlayer(sessionId);
          allow write: if false;
        }
      }

    }

    match /teamScheduleOperations/{operationId} {
      allow read, write: if false;
    }

    match /teamScheduleAudit/{auditId} {
      allow read, write: if false;
    }

    // Canonical standing and moderation records are server-only. The separate
    // self-readable projection contains no moderator identity, evidence, notes,
    // action path, reporter information, or child data.
    match /accountStanding/{userId} {
      allow read, create, update, delete: if false;
    }

    match /accountStandingPublic/{userId} {
      allow get: if permanentSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /moderationCases/{caseId} {
      allow read, create, update, delete: if false;
      match /{document=**} {
        allow read, create, update, delete: if false;
      }
    }

    match /moderationEvidence/{caseId} {
      allow read, create, update, delete: if false;
    }

    match /moderationAuditEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /moderationAlerts/{alertId} {
      allow read, create, update, delete: if false;
    }

    match /moderationPlaybackGrants/{grantId} {
      allow read, create, update, delete: if false;
    }

    match /moderationIdempotency/{requestId} {
      allow read, create, update, delete: if false;
    }

    match /moderationRateLimits/{rateLimitId} {
      allow read, create, update, delete: if false;
    }

    match /moderatorDirectory/{userId} {
      allow read, create, update, delete: if false;
    }

    match /userEnforcements/{userId}/{document=**} {
      allow read, create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // appConfig collection
    // Anyone authenticated can read. Only admin/server-side tooling can write.
    // -----------------------------------------------------------------------
    match /appConfig/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // activity collection
    // Historical activity is server-managed and has no active client consumer.
    // Trusted Admin SDK writers and account cleanup bypass client rules.
    // -----------------------------------------------------------------------
    match /activity/{activityId} {
      allow read, write: if false;
    }
  }
}
