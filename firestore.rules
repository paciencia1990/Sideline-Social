rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function squadPath(squadId) {
      return /databases/$(database)/documents/squads/$(squadId);
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function teamMemberPath(teamId, userId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(userId);
    }

    function announcementPath(teamId, announcementId) {
      return /databases/$(database)/documents/teams/$(teamId)/announcements/$(announcementId);
    }

    function isSquadMember(squadId) {
      return signedIn() &&
        exists(squadPath(squadId)) &&
        request.auth.uid in get(squadPath(squadId)).data.memberIds;
    }

    function isTeamMember(teamId) {
      return signedIn() &&
        exists(teamMemberPath(teamId, request.auth.uid)) &&
        get(teamMemberPath(teamId, request.auth.uid)).data.status == "active";
    }

    function isListedOnTeam() {
      return signedIn() &&
        (
          request.auth.uid in resource.data.coachIds ||
          request.auth.uid in resource.data.parentIds
        );
    }

    function isCoachStaff(teamId) {
      return isTeamMember(teamId) &&
        get(teamMemberPath(teamId, request.auth.uid)).data.role in ["coach", "assistantCoach", "teamParent"];
    }

    function isTeamCreator(teamId) {
      return signedIn() &&
        existsAfter(teamPath(teamId)) &&
        getAfter(teamPath(teamId)).data.createdBy == request.auth.uid;
    }

    function announcementAllowsReplies(teamId, announcementId) {
      return exists(announcementPath(teamId, announcementId)) &&
        get(announcementPath(teamId, announcementId)).data.allowReplies == true;
    }

    function isJoiningParentUpdate(teamId) {
      return signedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["parentIds", "updatedAt"]) &&
        request.resource.data.parentIds.hasAll(resource.data.parentIds) &&
        request.auth.uid in request.resource.data.parentIds &&
        existsAfter(teamMemberPath(teamId, request.auth.uid)) &&
        getAfter(teamMemberPath(teamId, request.auth.uid)).data.role == "parent" &&
        getAfter(teamMemberPath(teamId, request.auth.uid)).data.status == "active";
    }

    // -----------------------------------------------------------------------
    // users collection
    // Signed-in users can read profiles needed by app surfaces. Each user can
    // create/update only their own document, including Coach Mode fields.
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // squads collection
    // Squads stay separate from Teams. Coach staff rules do not grant Squad
    // write privileges.
    // -----------------------------------------------------------------------
    match /squads/{squadId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isSquadMember(squadId) ||
        request.auth.uid == resource.data.createdBy
      );
      allow delete: if signedIn() &&
        request.auth.uid == resource.data.createdBy;
    }

    // -----------------------------------------------------------------------
    // squadMemberships collection
    // Users can read/write only their own memberships. Cloud Functions use the
    // Admin SDK and bypass these rules.
    // -----------------------------------------------------------------------
    match /squadMemberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isSquadMember(resource.data.squadId)
      );
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // teams collection
    // Teams are private official coach/team spaces, separate from Squads.
    // -----------------------------------------------------------------------
    match /teams/{teamId} {
      allow get: if isListedOnTeam() || isTeamMember(teamId);
      allow list: if false;

      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.coachIds is list &&
        request.resource.data.coachIds.hasOnly([request.auth.uid]) &&
        request.resource.data.coachIds.hasAll([request.auth.uid]) &&
        request.resource.data.parentIds is list &&
        request.resource.data.parentIds.size() == 0;

      allow update: if isCoachStaff(teamId) || isJoiningParentUpdate(teamId);
      allow delete: if false;

      match /members/{userId} {
        allow get, list: if isSelf(userId) || isTeamMember(teamId);

        allow create: if signedIn() &&
          request.resource.data.userId == userId &&
          request.resource.data.teamId == teamId &&
          request.resource.data.status == "active" &&
          (
            (
              isSelf(userId) &&
              request.resource.data.role == "coach" &&
              isTeamCreator(teamId)
            ) ||
            (
              isSelf(userId) &&
              request.resource.data.role == "parent" &&
              exists(teamPath(teamId))
            ) ||
            (
              isCoachStaff(teamId) &&
              request.resource.data.role in ["coach", "assistantCoach", "teamParent", "parent"]
            )
          );

        allow update: if isSelf(userId) || isCoachStaff(teamId);
        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow get, list: if isTeamMember(teamId);

        allow create: if isCoachStaff(teamId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.audience in ["parents", "staff", "all"] &&
          request.resource.data.allowReplies is bool;

        allow update, delete: if isCoachStaff(teamId);

        match /replies/{replyId} {
          allow get, list: if isTeamMember(teamId);

          allow create: if isTeamMember(teamId) &&
            announcementAllowsReplies(teamId, announcementId) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.replyType in ["team", "privateToCoach"];

          allow update, delete: if false;
        }
      }
    }

    // -----------------------------------------------------------------------
    // appConfig collection
    // Anyone authenticated can read. Only admin/server-side tooling can write.
    // -----------------------------------------------------------------------
    match /appConfig/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // activity collection
    // Authenticated users can read app activity. Users can only write their own
    // activity entries.
    // -----------------------------------------------------------------------
    match /activity/{activityId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}