rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function authenticated() {
      return request.auth != null;
    }

    function anonymousAuth() {
      return authenticated() &&
        request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function signedIn() {
      return authenticated() && !anonymousAuth();
    }

    function standingPath() {
      return /databases/(default)/documents/accountStanding/$(request.auth.uid);
    }

    function hasCurrentStanding() {
      return signedIn() &&
        firestore.exists(standingPath()) &&
        (
          !("expiresAt" in firestore.get(standingPath()).data) ||
          !(firestore.get(standingPath()).data.expiresAt is timestamp) ||
          firestore.get(standingPath()).data.expiresAt > request.time
        );
    }

    function canCommunicate() {
      return signedIn() &&
        (
          !hasCurrentStanding() ||
          (
            firestore.get(standingPath()).data.status == "active" &&
            (
              !("messagingRestricted" in firestore.get(standingPath()).data) ||
              firestore.get(standingPath()).data.messagingRestricted != true
            )
          )
        );
    }

    function reservation(reservationId) {
      return firestore.get(/databases/(default)/documents/teamVoiceUploadReservations/$(reservationId)).data;
    }

    function friendReservation(reservationId) {
      return firestore.get(/databases/(default)/documents/friendChatUploadReservations/$(reservationId)).data;
    }

    function legacyFriendImage(image) {
      return !("mediaProfileVersion" in image) || image.mediaProfileVersion == 1;
    }

    function validFriendImageMain(image) {
      return image.main is map &&
        image.main.width is int &&
        image.main.height is int &&
        image.main.width > 0 &&
        image.main.height > 0 &&
        (
          (
            legacyFriendImage(image) &&
            image.main.mimeType in ["image/jpeg", "image/webp"] &&
            image.main.width <= 1600 &&
            image.main.height <= 1600 &&
            image.main.sizeBytes <= 3 * 1024 * 1024
          ) ||
          (
            image.mediaProfileVersion == 2 &&
            image.main.mimeType == "image/jpeg" &&
            image.main.width <= 1440 &&
            image.main.height <= 1440 &&
            image.main.sizeBytes <= 1024 * 1024
          )
        );
    }

    function validFriendImageThumbnail(image) {
      return image.thumbnail is map &&
        image.thumbnail.width is int &&
        image.thumbnail.height is int &&
        image.thumbnail.width > 0 &&
        image.thumbnail.height > 0 &&
        (
          (
            legacyFriendImage(image) &&
            image.thumbnail.mimeType in ["image/jpeg", "image/webp"] &&
            image.thumbnail.width <= 512 &&
            image.thumbnail.height <= 512 &&
            image.thumbnail.sizeBytes <= 512 * 1024
          ) ||
          (
            image.mediaProfileVersion == 2 &&
            image.thumbnail.mimeType == "image/jpeg" &&
            image.thumbnail.width <= 480 &&
            image.thumbnail.height <= 480 &&
            image.thumbnail.sizeBytes <= 120 * 1024
          )
        );
    }

    function validVoiceUpload(reservationId, teamId, kind, targetId) {
      let upload = reservation(reservationId);
      return canCommunicate() &&
        upload.status == "pending" &&
        upload.userId == request.auth.uid &&
        upload.teamId == teamId &&
        upload.kind == kind &&
        upload.targetId == targetId &&
        upload.expiresAt > request.time &&
        upload.voiceMemo is map &&
        upload.voiceMemo.mimeType in ["audio/mp4", "audio/m4a", "audio/x-m4a"] &&
        upload.voiceMemo.durationMilliseconds is int &&
        upload.voiceMemo.durationMilliseconds > 0 &&
        upload.voiceMemo.durationMilliseconds <= 90000 &&
        upload.voiceMemo.sizeBytes is int &&
        upload.voiceMemo.sizeBytes > 0 &&
        upload.voiceMemo.sizeBytes <= 2 * 1024 * 1024 &&
        request.resource.size == upload.voiceMemo.sizeBytes &&
        request.resource.contentType == upload.voiceMemo.mimeType;
    }

    match /teamVoiceMemos/{teamId}/announcements/{announcementId}/{reservationId}/memo.m4a {
      allow create: if validVoiceUpload(reservationId, teamId, "announcement", announcementId);
      allow read, update, delete: if false;
    }

    match /teamVoiceMemos/{teamId}/privateConversations/{conversationId}/{messageId}/{reservationId}/memo.m4a {
      allow create: if validVoiceUpload(reservationId, teamId, "privateMessage", messageId) &&
        reservation(reservationId).conversationId == conversationId;
      allow read, update, delete: if false;
    }

    match /friendChatMedia/{conversationId}/{messageId}/{reservationId}/voice.m4a {
      allow create: if canCommunicate() &&
        friendReservation(reservationId).status == "pending" &&
        friendReservation(reservationId).kind == "voice" &&
        friendReservation(reservationId).userId == request.auth.uid &&
        friendReservation(reservationId).conversationId == conversationId &&
        friendReservation(reservationId).targetId == messageId &&
        friendReservation(reservationId).storagePath == "friendChatMedia/" + conversationId + "/" + messageId + "/" + reservationId + "/voice.m4a" &&
        friendReservation(reservationId).expiresAt > request.time &&
        friendReservation(reservationId).voiceMemo is map &&
        friendReservation(reservationId).voiceMemo.mimeType in ["audio/mp4", "audio/m4a", "audio/x-m4a"] &&
        friendReservation(reservationId).voiceMemo.durationMilliseconds is int &&
        friendReservation(reservationId).voiceMemo.durationMilliseconds > 0 &&
        friendReservation(reservationId).voiceMemo.durationMilliseconds <= 120000 &&
        friendReservation(reservationId).voiceMemo.sizeBytes is int &&
        friendReservation(reservationId).voiceMemo.sizeBytes > 0 &&
        friendReservation(reservationId).voiceMemo.sizeBytes <= 3 * 1024 * 1024 &&
        request.resource.size == friendReservation(reservationId).voiceMemo.sizeBytes &&
        request.resource.contentType == friendReservation(reservationId).voiceMemo.mimeType;
      allow read, update, delete: if false;
    }

    match /friendChatMedia/{conversationId}/{messageId}/{reservationId}/image.jpg {
      allow create: if canCommunicate() &&
        friendReservation(reservationId).status == "pending" &&
        friendReservation(reservationId).kind == "image" &&
        friendReservation(reservationId).userId == request.auth.uid &&
        friendReservation(reservationId).conversationId == conversationId &&
        friendReservation(reservationId).targetId == messageId &&
        friendReservation(reservationId).fullPath == "friendChatMedia/" + conversationId + "/" + messageId + "/" + reservationId + "/image.jpg" &&
        friendReservation(reservationId).expiresAt > request.time &&
        friendReservation(reservationId).image is map &&
        validFriendImageMain(friendReservation(reservationId).image) &&
        friendReservation(reservationId).image.main.sizeBytes is int &&
        friendReservation(reservationId).image.main.sizeBytes > 0 &&
        request.resource.size == friendReservation(reservationId).image.main.sizeBytes &&
        request.resource.contentType == friendReservation(reservationId).image.main.mimeType;
      allow read, update, delete: if false;
    }

    match /friendChatMedia/{conversationId}/{messageId}/{reservationId}/thumbnail.jpg {
      allow create: if canCommunicate() &&
        friendReservation(reservationId).status == "pending" &&
        friendReservation(reservationId).kind == "image" &&
        friendReservation(reservationId).userId == request.auth.uid &&
        friendReservation(reservationId).conversationId == conversationId &&
        friendReservation(reservationId).targetId == messageId &&
        friendReservation(reservationId).thumbnailPath == "friendChatMedia/" + conversationId + "/" + messageId + "/" + reservationId + "/thumbnail.jpg" &&
        friendReservation(reservationId).expiresAt > request.time &&
        friendReservation(reservationId).image is map &&
        validFriendImageThumbnail(friendReservation(reservationId).image) &&
        friendReservation(reservationId).image.thumbnail.sizeBytes is int &&
        friendReservation(reservationId).image.thumbnail.sizeBytes > 0 &&
        request.resource.size == friendReservation(reservationId).image.thumbnail.sizeBytes &&
        request.resource.contentType == friendReservation(reservationId).image.thumbnail.mimeType;
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
