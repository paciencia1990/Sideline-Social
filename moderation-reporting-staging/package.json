{
  "name": "sideline-social-moderation-reporting-staging",
  "version": "1.0.0",
  "description": "Isolated staging-only Firebase Function for mobile moderation reports",
  "main": "lib/src/index.js",
  "scripts": {
    "prepare:source": "node scripts/prepare-source.cjs",
    "prepare:emulator": "npm run build && node scripts/prepare-emulator-rules.cjs",
    "build": "npm run prepare:source && tsc",
    "verify:isolation": "node scripts/verify-isolation.cjs",
    "verify:security-exception": "node scripts/verify-security-exception.cjs --project=sideline-social-staging-2026",
    "test:security-exception-policy": "node scripts/test-security-exception-policy.cjs",
    "test": "npm run build && npm run verify:isolation && npm run test:security-exception-policy"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "private": true
}
